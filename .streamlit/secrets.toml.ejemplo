# Plantilla de credenciales. Copia este fichero a `secrets.toml` (sin `.ejemplo`)
# y rellena el token.
#
# ⚠️ `secrets.toml` está en .gitignore y NO debe subirse nunca a GitHub.
#
# - En este PC: crea `.streamlit/secrets.toml` con estos valores para que el
#   buzón local escriba en la nube y los dos entornos vayan sincronizados.
#   Si no lo creas, todo sigue funcionando contra el histórico local.
#
# - En Streamlit Community Cloud: no subas ningún fichero. Pega este contenido
#   en Settings → Secrets de la app.
#
# El token es un fine-grained personal access token de GitHub con acceso SOLO
# al repo de datos y permiso `Contents: Read and write`.

[github]
repo  = "TU-USUARIO/revenue-neptuno-datos"
token = "github_pat_..."
rama  = "main"
